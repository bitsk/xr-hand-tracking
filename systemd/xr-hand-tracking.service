[Unit]
Description=XR shared-camera hand tracking and gesture service
ConditionPathExists=/etc/xr/hand-tracking.json

[Service]
Type=simple
ExecStart=/usr/bin/xr-hand-trackingd --config /etc/xr/hand-tracking.json
RuntimeDirectory=xr-hand-tracking
RuntimeDirectoryMode=0755
# Keep the IPC namespace across consumer updates; listeners belong to this service.
RuntimeDirectoryPreserve=yes
LogsDirectory=xr-hand-tracking
LogsDirectoryMode=0750
UMask=0022
KillMode=mixed
TimeoutStopSec=15
Restart=no

# Session/profile activation is explicit; installation never starts cameras.
